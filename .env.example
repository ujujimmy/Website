# ---------------------------------------------------------------------------
# Lead notifications (Resend). Without these the audit form still saves and
# logs the lead; only the email is skipped.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Booking (Cal.com). Your handle, e.g. "northbound/intro-call".
# Public: this one is meant to be visible in the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CAL_LINK=

# ---------------------------------------------------------------------------
# Payments (Razorpay Subscriptions).
#
# KEY_ID is public and safe in the browser. KEY_SECRET and WEBHOOK_SECRET are
# server-only — never prefix them with NEXT_PUBLIC_, and never commit real
# values. Rotate immediately if either one leaks.
#
# Use test keys (rzp_test_...) until you have taken a full test payment.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
