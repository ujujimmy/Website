# Copy to .env.local and fill in. Nothing here is required for `pnpm dev` to
# run — every integration degrades to a logged no-op when unconfigured.

# ---------------------------------------------------------------- lead email
RESEND_API_KEY=re_...          # without this, submissions still save + log, email no-ops
LEAD_NOTIFY_EMAIL=you@...      # where lead + payment notifications go
LEAD_FROM_EMAIL=leads@...      # optional, defaults to resend.dev

# ------------------------------------------------------------------ payments
# Razorpay Subscriptions. Dashboard → Settings → API Keys.
# Use rzp_test_* keys until you've run a full test payment through.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Dashboard → Settings → Webhooks. Create a webhook pointing at
# https://<your-domain>/api/razorpay/webhook and paste its secret here.
# Without this, webhooks are rejected — signatures can't be verified.
RAZORPAY_WEBHOOK_SECRET=...

# Plan IDs from Dashboard → Subscriptions → Plans. Create one monthly INR plan
# per tier at the price in content/pricing.ts. A tier with no plan ID here
# simply isn't purchasable — the "pay now" link won't render for it.
RAZORPAY_PLAN_STARTER=plan_...      # ₹15,000/month
RAZORPAY_PLAN_GROWTH=plan_...       # ₹45,000/month
RAZORPAY_PLAN_AUTHORITY=plan_...    # ₹105,000/month

# Optional. Billing cycles to authorise up front; 1–100, defaults to 60 (5 yrs).
# RAZORPAY_TOTAL_COUNT=60

# Optional escape hatch. Checkout normally refuses to run when a dashboard
# plan's amount disagrees with content/pricing.ts — set this only if you
# deliberately run promotional plans below list price.
# RAZORPAY_SKIP_PLAN_PRICE_CHECK=1
